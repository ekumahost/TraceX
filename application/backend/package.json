    "openai": "^4.67.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.7.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/cors": "^2.8.17"
  }
}
