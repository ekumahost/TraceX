# Copy to .env and fill in. At least one provider key is required for /api/explain and /api/ask.
PORT=4000

# Production: the frontend URL(s) allowed to call this API (comma-separated). Empty = allow all.
ALLOWED_ORIGINS=
# Per-IP limits for the public demo (0 = no limit)
TRACE_LIMIT_PER_HOUR=30
AI_LIMIT_PER_HOUR=60

# Which provider to try first: meta | fireworks | baseten (others are fallbacks)
AI_PROVIDER=meta

# Meta Model API (Muse Spark) - https://dev.meta.ai → Dashboard → API keys
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# low answers a case in ~10s; medium/high reason longer and slower
META_REASONING_EFFORT=low

# Fireworks AI (Meta Muse Spark Open, serverless) - https://fireworks.ai → API Keys
FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Blockchain data. One Alchemy key covers all 7 chains (enable each network in the Alchemy app);
# an Etherscan V2 key is a backup for many of them. Without keys only Ethereum and
# Optimism work, through slow, rate-limited free explorers. Alchemy strongly recommended.
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
# RPC_URL=https://ethereum-rpc.publicnode.com

# Python analysis engine (NetworkX). Leave empty to use the built-in TypeScript detectors.
# Local: http://localhost:8100   Modal: the URL printed by `modal deploy modal_app.py`
ANALYSIS_ENGINE_URL=

# Baseten Model APIs (Meta Muse Spark Open, no deployment needed) - https://app.baseten.co → API Keys
BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open
