# Copy to .env and fill in. At least one provider key is required for /api/explain and /api/ask.
PORT=4000

# Which provider to try first: meta | fireworks | baseten (others are fallbacks)
AI_PROVIDER=meta

# Meta Model API (Muse Spark) - https://dev.meta.ai → Dashboard → API keys
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Fireworks AI (Llama 3.3 70B) - https://fireworks.ai
FIREWORKS_API_KEY=

# Blockchain data. All optional - without keys TraceX uses Blockscout's free public API,
# which is slower and rate-limited. A free Etherscan key is strongly recommended for demos.
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
# RPC_URL=https://ethereum-rpc.publicnode.com

# Python analysis engine (NetworkX). Leave empty to use the built-in TypeScript detectors.
# Local: http://localhost:8100   Modal: the URL printed by `modal deploy modal_app.py`
ANALYSIS_ENGINE_URL=

# Baseten (Llama 3.3 70B) - https://app.baseten.co (deploy Llama 3.3 70B Instruct first)
BASETEN_API_KEY=
BASETEN_MODEL_ID=
